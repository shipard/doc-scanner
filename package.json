{
  "name": "scandoc",
  "version": "1.0.0",
  "description": "PWA for scanning and sending documents via email",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "tsc -p tsconfig.server.json && cp -r src/server/views dist/server/views && vite build",
    "start": "node dist/server/index.js",
    "db:migrate": "node-pg-migrate up --database-url-var DATABASE_URL --migrations-dir src/server/db/migrations --migration-file-language sql",
    "create-admin": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/csrf-protection": "^7.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/passport": "^3.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/session": "^11.0.0",
    "@fastify/static": "^8.0.0",
    "@fastify/view": "^10.0.0",
    "bootstrap-icons": "^1.13.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "fastify": "^5.0.0",
    "nodemailer": "^8.0.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "overrides": {
    "filelist": {
      "minimatch": "^10.2.1"
    }
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "i18next": "^24.0.5",
    "idb": "^8.0.0",
    "node-pg-migrate": "^8.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.3",
    "react-router-dom": "^7.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1"
  }
}
