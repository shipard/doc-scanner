# Server
PORT=3000
HOST=0.0.0.0
BASE_URL=https://app.example.com
NODE_ENV=development

# Database
DATABASE_URL=postgresql://scandoc:password@localhost:5432/scandoc

# OAuth - Google
GOOGLE_CLIENT_ID=xxx
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_CALLBACK_URL=https://app.example.com/auth/google/callback

# Session
SESSION_SECRET=change-me-in-production-use-long-random-string

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=xxx
SMTP_FROM=ScanDoc <noreply@example.com>

# Auto-approval webhook
APPROVAL_WEBHOOK_URL=
APPROVAL_WEBHOOK_TIMEOUT=5000

# Invites
INVITE_EXPIRY_DAYS=7
