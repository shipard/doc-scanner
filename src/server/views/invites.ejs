<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>Invites</h2>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createInviteModal">
    <i class="bi bi-envelope-plus"></i> Create Invite
  </button>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead class="table-dark">
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Status</th>
          <th>Created By</th>
          <th>Created</th>
          <th>Expires</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% invites.forEach(function(invite) { %>
          <tr>
            <td><%= invite.name || '—' %></td>
            <td><%= invite.email %></td>
            <td>
              <% if (invite.status === 'accepted') { %>
                <span class="badge bg-success">Accepted</span>
              <% } else if (invite.status === 'expired') { %>
                <span class="badge bg-secondary">Expired</span>
              <% } else { %>
                <span class="badge bg-primary">Pending</span>
              <% } %>
            </td>
            <td><%= invite.created_by_name || 'API' %></td>
            <td><%= new Date(invite.created_at).toLocaleDateString('cs-CZ') %></td>
            <td><%= new Date(invite.expires_at).toLocaleDateString('cs-CZ') %></td>
            <td>
              <% if (invite.status === 'pending') { %>
                <button class="btn btn-sm btn-outline-info"
                  onclick="navigator.clipboard.writeText('<%= baseUrl %>/invite/<%= invite.token %>')" title="Copy invite link">
                  <i class="bi bi-clipboard"></i>
                </button>
                <button class="btn btn-sm btn-outline-danger"
                  onclick="if(confirm('Cancel this invite?')) { fetch('/admin/invites/<%= invite.id %>', {method:'DELETE'}).then(() => location.reload()) }">
                  Cancel
                </button>
              <% } %>
            </td>
          </tr>
        <% }) %>
        <% if (invites.length === 0) { %>
          <tr><td colspan="7" class="text-center text-muted py-3">No invites found</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Create Invite Modal -->
<div class="modal fade" id="createInviteModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/admin/invites" method="post">
        <div class="modal-header">
          <h5 class="modal-title">Create Invite</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Name</label>
            <input type="text" name="name" class="form-control" placeholder="Jan Novák">
          </div>
          <div class="mb-3">
            <label class="form-label">Email *</label>
            <input type="email" name="email" class="form-control" required placeholder="jan@example.com">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Send Invite</button>
        </div>
      </form>
    </div>
  </div>
</div>
