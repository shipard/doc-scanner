<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>API Keys</h2>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createKeyModal">
    <i class="bi bi-plus-lg"></i> Create API Key
  </button>
</div>

<% if (typeof newKey !== 'undefined' && newKey) { %>
  <div class="alert alert-success">
    <strong>New API key created!</strong> Copy it now — it won't be shown again:
    <div class="mt-2">
      <code class="fs-6 user-select-all"><%= newKey %></code>
      <button class="btn btn-sm btn-outline-success ms-2"
        onclick="navigator.clipboard.writeText('<%= newKey %>')">Copy</button>
    </div>
  </div>
<% } %>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead class="table-dark">
        <tr>
          <th>Name</th>
          <th>Prefix</th>
          <th>Active</th>
          <th>Created By</th>
          <th>Created</th>
          <th>Last Used</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% apiKeys.forEach(function(key) { %>
          <tr>
            <td><%= key.name %></td>
            <td><code><%= key.key_prefix %>...</code></td>
            <td>
              <% if (key.is_active) { %>
                <span class="badge bg-success">Active</span>
              <% } else { %>
                <span class="badge bg-secondary">Inactive</span>
              <% } %>
            </td>
            <td><%= key.created_by_name %></td>
            <td><%= new Date(key.created_at).toLocaleDateString('cs-CZ') %></td>
            <td><%= key.last_used_at ? new Date(key.last_used_at).toLocaleString('cs-CZ') : 'Never' %></td>
            <td>
              <% if (key.is_active) { %>
                <button class="btn btn-sm btn-outline-danger"
                  onclick="if(confirm('Deactivate key <%= key.name %>?')) { fetch('/admin/api-keys/<%= key.id %>', {method:'DELETE'}).then(() => location.reload()) }">
                  Deactivate
                </button>
              <% } %>
            </td>
          </tr>
        <% }) %>
        <% if (apiKeys.length === 0) { %>
          <tr><td colspan="7" class="text-center text-muted py-3">No API keys found</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Create Key Modal -->
<div class="modal fade" id="createKeyModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/admin/api-keys" method="post">
        <div class="modal-header">
          <h5 class="modal-title">Create API Key</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Name / Description *</label>
            <input type="text" name="name" class="form-control" required placeholder="ERP system">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Create Key</button>
        </div>
      </form>
    </div>
  </div>
</div>
