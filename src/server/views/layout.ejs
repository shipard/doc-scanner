<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — ScanDoc Admin</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body { background: #f8f9fa; }
    .sidebar { min-height: 100vh; background: #212529; }
    .sidebar .nav-link { color: #adb5bd; }
    .sidebar .nav-link:hover, .sidebar .nav-link.active { color: #fff; background: rgba(255,255,255,0.1); border-radius: 4px; }
    .sidebar .nav-link i { margin-right: 8px; }
    .main-content { flex: 1; }
  </style>
</head>
<body>
  <div class="d-flex">
    <nav class="sidebar p-3" style="width: 220px; flex-shrink: 0;">
      <div class="text-white fw-bold fs-5 mb-4">
        <i class="bi bi-file-earmark-text"></i> ScanDoc
      </div>
      <ul class="nav flex-column gap-1">
        <li class="nav-item">
          <a class="nav-link" href="/admin"><i class="bi bi-speedometer2"></i> Dashboard</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/admin/users"><i class="bi bi-people"></i> Users</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/admin/invites"><i class="bi bi-envelope"></i> Invites</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/admin/logs"><i class="bi bi-journal-text"></i> Logs</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/admin/api-keys"><i class="bi bi-key"></i> API Keys</a>
        </li>
        <li class="nav-item mt-4">
          <form action="/auth/logout" method="post" class="d-inline">
            <button class="nav-link border-0 bg-transparent text-danger w-100 text-start">
              <i class="bi bi-box-arrow-left"></i> Logout
            </button>
          </form>
        </li>
      </ul>
    </nav>

    <div class="main-content p-4">
      <% if (typeof flash !== 'undefined' && flash) { %>
        <div class="alert alert-<%= flash.type %> alert-dismissible fade show" role="alert">
          <%= flash.message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <%- body %>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
